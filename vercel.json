{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "translations.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/ner_data.js",
      "use": "@vercel/static"
    },
    {
      "src": "data/ner_predictions.js",
      "use": "@vercel/static"
    },
    {
      "src": "ne_mountains.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "pitch_deck_preview.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/translations.js",
      "dest": "/translations.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/data/ner_data.js",
      "dest": "/data/ner_data.js"
    },
    {
      "src": "/data/ner_predictions.js",
      "dest": "/data/ner_predictions.js"
    },
    {
      "src": "/ne_mountains.jpg",
      "dest": "/ne_mountains.jpg"
    },
    {
      "src": "/pitch_deck_preview.html",
      "dest": "/pitch_deck_preview.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
